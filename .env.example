# The Signal number the bot itself uses, in E.164 format (e.g. +15551234567)
# This must be the number you registered/linked in signal-cli-rest-api
SIGNAL_NUMBER=+XXXXXXXXXXX

# Internal URL of the signal-cli-rest-api container (leave as-is if using docker-compose)
SIGNAL_API_URL=http://signal-api:8080

# Comma-separated E.164 numbers allowed to run admin commands (!add, !remove, !members)
ADMIN_NUMBERS=+XXXXXXXXXXX

# Local LLM for summarization, served by the Ollama container - no API key, no cost
OLLAMA_URL=http://ollama:11434
# Small models that run fine on CPU. Pull one after first boot, e.g.:
#   docker compose exec ollama ollama pull llama3.2:3b
OLLAMA_MODEL=llama3.2:3b

# faster-whisper model size: tiny, base, small, medium, large-v3
# bigger = more accurate but slower / more RAM. "small" is a good default on CPU.
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Path inside the bot container where the sqlite db lives (matches the volume mount)
DB_PATH=/data/duty_bot.db
